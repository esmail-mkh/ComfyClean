{
  "manifestVersion": 5,
  "id": "com.local.comfyclean",
  "name": "Comfy Clean",
  "version": "1.1.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": {
        "default": "Comfy Clean"
      },
      "minimumSize": {
        "width": 230,
        "height": 300
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 260,
        "height": 420
      },
      "preferredFloatingSize": {
        "width": 260,
        "height": 420
      }
    },
    {
      "type": "command",
      "id": "clean",
      "label": {
        "default": "Comfy Clean: Clean selection"
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        ".vbs"
      ]
    }
  }
}
