{
  "manifestVersion": 5,
  "id": "com.local.comfyclean",
  "name": "Comfy Clean",
  "version": "1.0.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "25.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "main",
      "label": { "default": "Comfy Clean" },
      "minimumSize": { "width": 230, "height": 300 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 260, "height": 420 },
      "preferredFloatingSize": { "width": 260, "height": 420 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": "all" },
    "localFileSystem": "plugin"
  }
}
